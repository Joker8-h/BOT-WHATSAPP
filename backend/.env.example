PORT=4000
DATABASE_URL="mysql://usuario:password@localhost:3306/fantasias"

# OpenAI 
OPENAI_API_KEY="sk-..."

# Notas de voz (Whisper). Necesita una key directa de OpenAI (no de OpenRouter).
# Si OPENAI_API_KEY ya es de OpenAI, esta variable es opcional.
OPENAI_TRANSCRIPTION_API_KEY=""
TRANSCRIPTION_MODEL="whisper-1"

# Milisegundos que Sofía espera para agrupar mensajes seguidos del mismo cliente
MESSAGE_BURST_WINDOW_MS=4000

# Wompi: Pasarela de pagos
WOMPI_API_URL="https://production.wompi.co/v1"
WOMPI_PUBLIC_KEY="pub_prod_..."
WOMPI_PRIVATE_KEY="prv_prod_..."
WOMPI_INTEGRITY_SECRET="prod_integrity_..."
WOMPI_EVENTS_SECRET="prod_events_..."

# PIN para registrarse como admin desde WhatsApp: /admin <número sede> <PIN> <nombre>
# Si se deja vacío, el comando queda desactivado (los admins se agregan desde el panel).
ADMIN_REGISTRATION_PIN=""

# Alertas al dueño (se envían al teléfono de notificación de cada sede)
# OWNER_ALERTS=off las apaga todas. Para apagar solo algunas, lista sus tipos:
# escalation, complaint, hesitation, vip_back, link_abandoned, payment_declined,
# payment_orphan, payment_mismatch, ai_down, admin_registered, daily_summary
OWNER_ALERTS=on
OWNER_ALERTS_DISABLED=""
# Valor mínimo del producto para avisar de una "venta grande en duda"
OWNER_ALERT_HIGH_VALUE=150000
# Total gastado a partir del cual un cliente es VIP (o 2+ compras)
OWNER_ALERT_VIP_SPENT=150000

# Catálogo de la tienda web (fuente principal de productos, se sincroniza cada 20 min)
# Por defecto usa la API de la página y carga los productos en la sede 1.
STORE_PRODUCTS_API=on
STORE_PRODUCTS_API_URL="https://backend-production-daf05.up.railway.app/api/products"
# Sedes que usan este catálogo (separadas por coma)
STORE_PRODUCTS_BRANCH_IDS=1

# Seguridad y Autenticación
JWT_SECRET="tu_jwt_secret_super_seguro_aqui_minimo_32_caracteres"
ENCRYPTION_KEY="clave_de_32_bytes_para_cifrado_aes_gcm"

# Costo de envío que se suma al total del pedido (COP)
# Ciudades con envío local (separadas por coma); el resto paga envío nacional
SHIPPING_LOCAL_CITIES="Popayán, Florencia"
SHIPPING_LOCAL_FEE=6000
SHIPPING_NATIONAL_FEE=15000

# Delays de respuesta humana anti-bloqueo (milisegundos)
MIN_RESPONSE_DELAY_MS=1500
MAX_RESPONSE_DELAY_MS=4000

# Cloudinary (Multimedia) — usar las 3 credenciales, o en su defecto CLOUDINARY_URL
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="fantasias/products"
# Alternativa: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=""

